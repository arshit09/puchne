# Cloudflare credentials for wrangler and tools/cf-dns.ps1.
#
# Copy this file to .env and fill in the blanks. .env is gitignored, so the real
# values stay on your machine. Wrangler picks CLOUDFLARE_* up automatically from
# .env whenever it runs from the repo root — no shell exports, no wrangler login.
#
# Nothing here is needed to work on the extension itself; it is only for
# publishing website/ to a subdomain of your own domain.


# --- The one secret ---------------------------------------------------------
#
# Cloudflare has TWO kinds of API token and they are not interchangeable:
#
#   Account API token  (Manage Account -> API Tokens)
#     Holds ACCOUNT-scoped permissions only. Enough to deploy the Worker and
#     attach its Custom Domain, because both go through /accounts/... endpoints.
#     It CANNOT touch zone endpoints -- /zones/<id>/dns_records returns
#     "10000: Authentication error" no matter what the dashboard shows. An
#     "Entire Account -> Read & Write" policy does not change this.
#
#   User API token  (My Profile -> API Tokens)
#     Supports Zone Resources, so this is the only kind that works for
#     tools/cf-dns.ps1 and any other raw DNS record work.
#
# For `wrangler deploy` (including the custom domain) an Account API token with
# Workers Scripts: Edit is enough.
#
# For tools/cf-dns.ps1 you need a User API token with:
#   Zone | DNS           | Edit
#   Zone | Zone          | Read
#   Zone Resources: Include -> Specific zone -> your domain
#
# Treat this like a password. Anyone holding it can deploy code to your domain.
# Prefer a token scoped to just what it needs over an account-wide one.
CLOUDFLARE_API_TOKEN=

# --- Identifiers (not secret, but tedious to look up every time) ------------

# Dashboard -> Workers & Pages -> right-hand sidebar -> Account ID
CLOUDFLARE_ACCOUNT_ID=

# Dashboard -> your domain -> Overview -> right-hand sidebar -> Zone ID
# Only tools/cf-dns.ps1 needs this; wrangler works the zone out from the
# hostname on its own.
CLOUDFLARE_ZONE_ID=

# The domain exactly as Cloudflare lists it, with no scheme and no trailing
# dot. Example: puchne.com
CF_ZONE_NAME=

# The full hostname the site should answer on. Example: www.puchne.com
# Whatever you put here also goes in the `routes` block of wrangler.jsonc.
CF_SUBDOMAIN=
